# ============================================================
#  Configuración del pipeline de acrónimos -> BigQuery (RAG)
#  Copia este archivo como .env y llena los valores.
# ============================================================

# --- Proyecto GCP ---
GCP_PROJECT_ID=data-lakehouse-494719

# --- Cuenta de servicio de BigQuery ---
# Opción A (recomendada): ruta al archivo JSON de la cuenta de servicio
GCP_SA_BIGQUERY_FILE=./credentials/sa-bigquery.json
# Opción B: pegar el JSON completo en UNA sola línea (si se llena, tiene prioridad)
GCP_SA_BIGQUERY_JSON=

# --- Cuenta de servicio de Vertex AI (embeddings) ---
# Si es la misma cuenta que BigQuery, puedes dejar ambas vacías y se usará la de BigQuery.
GCP_SA_VERTEX_FILE=./credentials/sa-vertex.json
GCP_SA_VERTEX_JSON=

# --- BigQuery ---
# Debe coincidir con la región de tus datasets (US, EU, us-central1, ...)
BQ_LOCATION=US
BQ_DATASET_BRONZE=bronze
BQ_DATASET_SILVER=silver
BQ_DATASET_GOLD=gold

# --- Vertex AI ---
VERTEX_LOCATION=us-central1
# Modelo multilingüe (bueno para español). Usa el MISMO modelo en n8n para la pregunta.
EMBEDDING_MODEL=text-multilingual-embedding-002
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=50

# --- Archivos de entrada (.xlsx / .csv) ---
DATA_DIR=.
