# ============================================================
#  Carga de acrónimos a BigQuery (dataset bronze)
#  Copia este archivo como .env y llena los valores.
# ============================================================

GCP_PROJECT_ID=data-lakehouse-494719

# Cuenta de servicio de BigQuery
# Opción A (recomendada): ruta al archivo JSON
GCP_SA_BIGQUERY_FILE=./credentials/sa-bigquery.json
# Opción B: el JSON completo en UNA sola línea (si se llena, tiene prioridad)
GCP_SA_BIGQUERY_JSON=

BQ_DATASET_BRONZE=bronze
# Opcional: la región se toma del dataset. Sólo se usa si hay que crearlo.
BQ_LOCATION=

# Carpeta con los .xlsx / .csv
DATA_DIR=.
